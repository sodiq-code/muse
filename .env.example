# ============================================================================
# MUSE — Environment Variables Template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# SECURITY:
#   - `.env` is git-ignored and MUST NEVER be committed.
#   - If secrets are ever committed, rotate them immediately and purge history.
#   - Production deployments should inject these via the hosting platform's
#     secret manager (e.g. Vercel project environment variables), NOT via files.
# ============================================================================

# --- Database (local dev) ---
DATABASE_URL=file:./dev.db

# --- Turso Cloud Database (optional — used for Vercel/serverless deploys) ---
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJF...

# --- Minds Platform — mode ---
# "live" = call the real Minds SDK; "simulate" = use deterministic local mock data
MINDS_MODE=live

# --- Account 1: Muse (Orchestrator) ---
MINDS_BUILDER_API_KEY=your-muse-builder-api-key
MINDS_HUMAN_ID=your-muse-human-id
MINDS_MUSE_ID=your-muse-mind-id
MINDS_MUSE_EMAIL=your-muse-account@example.com

# --- Account 2: Maker (Creative executor) ---
MINDS_MAKER_API_KEY=your-maker-builder-api-key
MINDS_MAKER_HUMAN_ID=your-maker-human-id
MINDS_MAKER_ID=your-maker-mind-id
MINDS_MAKER_EMAIL=your-maker-account@example.com

# --- Creator profile (used by ingestion + learning engine) ---
CREATOR_NAME=Your Name
CREATOR_EMAIL=your-creator@example.com
CREATOR_PLATFORM=youtube
